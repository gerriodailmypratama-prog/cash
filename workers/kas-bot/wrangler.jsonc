{
  // Kas capture bot (PR-CL26). Telegram webhook -> LLM parse -> confirm -> ledger.
  // Also pings the owner on Telegram when a new statement lands in R2 (cron scan).
  "name": "kas-bot",
  "main": "index.js",
  "compatibility_date": "2025-01-01",

  // Pending-confirmation store + short-lived account cache + statement-seen marks.
  // Create with:  npx wrangler kv namespace create kas_bot_kv
  // then paste the returned id below.
  "kv_namespaces": [
    { "binding": "BOT_KV", "id": "2430f1abdd2e4541b44e55b802a7c05b" }
  ],

  // Same bucket the email pipe writes statements into (read-only use here).
  "r2_buckets": [
    { "binding": "STATEMENTS", "bucket_name": "kas-statements" }
  ],

  // Cloudflare Workers AI — the parse brain (free tier, no external key).
  "ai": { "binding": "AI" },

  // Scan R2 for new statements every 15 min and ping the owner.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Non-secret config. Secrets (tokens/keys) are set with `wrangler secret put`
  // — see README. NEVER put tokens or the service key in this file.
  "vars": {
    "SUPABASE_URL": "https://ryuwnsxwtwfmndnbysxw.supabase.co",
    "DB_SCHEMA": "cash",
    "WORKER_URL": "https://kas-bot.gerriodailmypratama.workers.dev",
    "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "GEMINI_MODEL": "gemini-2.0-flash"
  }
}
